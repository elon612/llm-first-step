# Copy this file to .env and fill in one of the keys below.
# Never commit .env. The offline demos run without any API key.

# xAI (Grok) — recommended for this lesson
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4

# Any OpenAI-compatible endpoint also works
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
